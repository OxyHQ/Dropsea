{
  "name": "@dropsea/backend",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/credential-providers": "^3.1161.0",
    "@oxy.so/bloom": "17.23.0",
    "@oxy.so/core": "7.46.0",
    "@oxy.so/db": "^1.4.0",
    "@dropsea/shared-types": "workspace:*",
    "drizzle-orm": "0.45.4",
    "exif-reader": "^2.0.3",
    "express": "^5.3.0",
    "postgres": "3.4.9",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "drizzle-kit": "0.31.11",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f docker-compose.postgres.yml up -d postgres",
    "db:down": "docker compose -f docker-compose.postgres.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "test": "bun test src"
  }
}
