# Local Postgres from `bun run db:up`.
DATABASE_URL=postgres://dropsea:dropsea@127.0.0.1:5434/dropsea_dev
PORT=4300
OXY_API_URL=https://api.oxy.so
# Comma-separated browser origins besides the *.oxy.so family. Unset, it is
# https://dropsea.net, the web app's origin; a value replaces that default.
CORS_ORIGINS=https://dropsea.net,http://localhost:8081
