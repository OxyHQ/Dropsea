# Response headers for the Worker's static assets (wrangler.toml). Cloudflare
# applies these to every request that matches a file of the export, which is
# every request the Worker itself never sees.

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

# Every response. A Pages project adds both on its own; Workers Static Assets
# does not, so they are declared (~/Oxy/docs/infra-and-deploys.md).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
